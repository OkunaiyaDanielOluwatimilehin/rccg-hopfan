{
  "routes": [
    { "src": "/event/(.*)", "dest": "/api/share/event/$1" },
    { "src": "/article/(.*)", "dest": "/api/share/article/$1" },
    { "src": "/sermon/(.*)", "dest": "/api/share/sermon/$1" },
    { "src": "/devotional/(.*)", "dest": "/api/share/devotional/$1" },
    { "handle": "filesystem" },
    { "src": "/((?!api/).*)", "dest": "/index.html" }
  ]
}
